#!/bin/bash
# JankyBorders - glowing Catppuccin border on the focused window, faint one on the rest (mac-dotfiles, 2026-10-06).
options=(
  style=round
  width=4.0
  hidpi=on
  active_color="gradient(top_left=0xffb4befe,bottom_right=0xffcba6f7)"
  inactive_color=0x5545475a
)
borders "${options[@]}"
